# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=*

DATABASE_URL=postgres://tnn_app:CHANGE_ME@localhost:5432/Neighbourhood_APP
# Used ONLY by scripts/run_migrations.py — a superuser/owner role so schema+grants apply correctly.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/Neighbourhood_APP

# JWT — short-lived access token; refresh tokens are DB-backed (see refresh_tokens table)
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ACCESS_TTL_MINUTES=15

# SMS OTP gateway (99smsservice.com) — swappable adapter, see src/adapters/notification/SmsAdapter.ts
SMS_GATEWAY_BASE_URL=https://login.99smsservice.com/sms/api
SMS_API_KEY=CHANGE_ME
SMS_SENDER_ID=SCOLAS
SMS_ENTITY_ID=CHANGE_ME
SMS_TEMPLATE_ID=CHANGE_ME
# {otp} is substituted at send time
SMS_TEMPLATE=Dear Resident, OTP to log into Trusted Neighbourhood Network is {otp}. Thank you.

# When true, OTP send responses also echo the plaintext OTP in the API response (local/dev only — never in prod)
DEV_EXPOSE_OTP=true

# Razorpay (India-compatible gateway) — leave blank in dev; payment/webhook endpoints degrade gracefully
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
